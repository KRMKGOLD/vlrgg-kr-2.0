<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VlrggMobile" parent="android:style/Theme.Material.Light.NoActionBar" />

    <style name="Theme.VlrggMobile.Splash" parent="Theme.SplashScreen.IconBackground">
        <!-- DESIGN.md Surface window; the 240dp ticket icon sits on the launcher background colour inside a 160dp circle. -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/Theme.VlrggMobile</item>
    </style>
</resources>
